# ── Proveedores de IA ────────────────────────────────────────────────────────
# IA_PROVIDER: 'groq' (principal ultrarrápido), 'gemini' o 'ollama' (100% local y offline)
IA_PROVIDER=groq
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Proveedores Cloud (Groq y Google Gemini como respaldo automático)
GROQ_API_KEY=
MODELO_VISION=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Base de Datos & Embeddings ────────────────────────────────────────────────
DATABASE_URL=postgresql://pdfvision:pdfvision@localhost:5434/pdfvision
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── Límites & OCR ────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
OCR_LANG=spa+eng

# ── RAG y Chunking ───────────────────────────────────────────────────────────
RAG_SIMILARITY_THRESHOLD=0.35
RAG_TOP_K=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── Visión Multimodal en Ingesta ─────────────────────────────────────────────
ENABLE_VISION_DESCRIPTIONS=false
VISION_MAX_IMAGES_PER_DOCUMENT=10

# ── Seguridad & CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

